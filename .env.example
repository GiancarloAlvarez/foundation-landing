DATABASE_URL="postgresql://fumablac:fumablac_dev@localhost:5433/fumablac?schema=public"
SESSION_SECRET="replace-with-a-random-32+-char-secret"
SEED_ADMIN_EMAIL="admin@fumablac.org"
SEED_ADMIN_PASSWORD="replace-with-a-strong-dev-password"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Envío de correo (SMTP) ---
# Proveedor: Brevo (https://brevo.com) — 300 correos/día gratis.
# Brevo → SMTP & API → SMTP → "Generate a new SMTP key".
# SMTP_USER es el login que muestra el panel; SMTP_PASS es la SMTP key
# (NO la contraseña de la cuenta, NO la API key).
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Remitente: debe estar verificado en Brevo (Senders & IP → Senders) o ser una
# dirección de un dominio autenticado por DNS (SPF/DKIM/DMARC).
SMTP_FROM="fundacionmamablanca@hotmail.com"
SMTP_FROM_NAME="Fundación Mamá Blanca"
# Destino de las respuestas de quien escribe al formulario de contacto.
SMTP_REPLY_TO="fundacionmamablanca@hotmail.com"

# --- Deprecated: flujo Outlook OAuth2 (sin uso desde la migración a Brevo) ---
